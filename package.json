{
  "name": "plinto",
  "version": "1.3.1",
  "private": true,
  "type": "module",
  "description": "PLINTO — puzzle game a blocchi originale, gratuito e senza pubblicita.",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:watch": "vitest",
    "sim": "node src/sim/run.mjs",
    "e2e": "node tests/e2e/partita.mjs",
    "soak": "node tests/e2e/resistenza.mjs",
    "precisione": "node tests/e2e/precisione.mjs",
    "schermate": "node tools/schermate.mjs",
    "icone": "node tools/icone.mjs",
    "prova-pages": "npm run build && node tools/prova-sottocartella.mjs",
    "prova-desktop": "node tools/prova-desktop.mjs",
    "quadri": "node tools/quadri.mjs",
    "e2e-quadri": "node tests/e2e/quadri.mjs",
    "archivio": "node tests/e2e/archivio.mjs",
    "condivisione": "node tests/e2e/condivisione.mjs",
    "anteprima": "node tests/e2e/anteprima.mjs",
    "livelli": "node tests/e2e/tutti-i-livelli.mjs",
    "taratura": "node tools/taratura.mjs",
    "confronto": "node tools/confronto-anteprima.mjs",
    "privacy": "node tools/privacy-html.mjs",
    "contrasti": "node tools/contrasti.mjs",
    "catena": "node tools/misura-catena.mjs",
    "comunicazioni": "node tests/e2e/comunicazioni.mjs",
    "installazione": "npm run build && node tests/e2e/installazione.mjs",
    "verifica": "node tools/verifica-tutto.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "playwright": "^1.63.0",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
