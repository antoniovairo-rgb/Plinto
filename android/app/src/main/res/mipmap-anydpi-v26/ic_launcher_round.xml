<?xml version="1.0" encoding="utf-8"?>
<!--
  Icona adattiva, per Android 8 in su: il sistema la ritaglia nella forma che preferisce
  (cerchio, quadrato con angoli, goccia). Per questo il primo piano e' la versione
  "maskable" dell'icona, disegnata con margine attorno: quella normale verrebbe tagliata.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/sfondoIcona" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
